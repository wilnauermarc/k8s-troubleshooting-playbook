---
import Slide from '../ui/Slide.astro';
---

<Slide
  id="s13-signals"
  chapter="Rules & Models"
  title="The Signal Triangle"
  notes="Draw attention to the triangle. Three corners are the classic observability trio — Logs (WHY), Metrics (WHEN), Traces (WHERE). The center is Kubernetes Events (WHAT). Often start with Events/Conditions; reorder when the symptom already points at logs (e.g. CrashLoop)."
>
  <div class="stagger mx-auto flex w-full max-w-4xl flex-col items-center gap-5">
    <svg
      viewBox="0 0 640 520"
      class="h-auto w-full max-w-xl drop-shadow-[0_0_40px_rgba(45,212,191,0.12)]"
      role="img"
      aria-label="Signal triangle: Events at center, Logs Metrics and Traces at corners"
    >
      <defs>
        <linearGradient id="tri-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.9" />
          <stop offset="50%" stop-color="#60a5fa" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="tri-fill" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.12" />
          <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.04" />
        </linearGradient>
        <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
      </defs>

      <!-- Triangle body -->
      <polygon
        points="320,48 560,440 80,440"
        fill="url(#tri-fill)"
        stroke="url(#tri-stroke)"
        stroke-width="3"
        stroke-linejoin="round"
      />

      <!-- Inner accent lines toward center -->
      <line x1="320" y1="48" x2="320" y2="268" stroke="#2dd4bf" stroke-opacity="0.25" stroke-width="1.5" stroke-dasharray="6 6" />
      <line x1="560" y1="440" x2="320" y2="268" stroke="#60a5fa" stroke-opacity="0.25" stroke-width="1.5" stroke-dasharray="6 6" />
      <line x1="80" y1="440" x2="320" y2="268" stroke="#a78bfa" stroke-opacity="0.25" stroke-width="1.5" stroke-dasharray="6 6" />

      <!-- Top: Metrics — WHEN -->
      <g filter="url(#glow)">
        <rect x="230" y="8" width="180" height="72" rx="14" fill="#0d1526" stroke="#fbbf24" stroke-width="2.5" />
        <text x="320" y="38" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="18" font-weight="700">
          Metrics
        </text>
        <text x="320" y="62" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="14" font-weight="600" letter-spacing="0.12em">
          WHEN
        </text>
      </g>

      <!-- Bottom left: Logs — WHY -->
      <g filter="url(#glow)">
        <rect x="8" y="410" width="180" height="72" rx="14" fill="#0d1526" stroke="#2dd4bf" stroke-width="2.5" />
        <text x="98" y="440" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="18" font-weight="700">
          Logs
        </text>
        <text x="98" y="464" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="14" font-weight="600" letter-spacing="0.12em">
          WHY
        </text>
      </g>

      <!-- Bottom right: Traces — WHERE -->
      <g filter="url(#glow)">
        <rect x="452" y="410" width="180" height="72" rx="14" fill="#0d1526" stroke="#a78bfa" stroke-width="2.5" />
        <text x="542" y="440" text-anchor="middle" fill="#a78bfa" font-family="Sora, sans-serif" font-size="18" font-weight="700">
          Traces
        </text>
        <text x="542" y="464" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="14" font-weight="600" letter-spacing="0.12em">
          WHERE
        </text>
      </g>

      <!-- Center: Events — WHAT -->
      <g filter="url(#glow)">
        <circle cx="320" cy="268" r="78" fill="#0d1526" stroke="#60a5fa" stroke-width="3" />
        <circle cx="320" cy="268" r="68" fill="#60a5fa" fill-opacity="0.08" stroke="none" />
        <text x="320" y="258" text-anchor="middle" fill="#60a5fa" font-family="Sora, sans-serif" font-size="20" font-weight="700">
          Events
        </text>
        <text x="320" y="286" text-anchor="middle" fill="#e8eef9" font-family="Sora, sans-serif" font-size="15" font-weight="600" letter-spacing="0.14em">
          WHAT
        </text>
      </g>
    </svg>

    <p class="max-w-2xl text-center text-lg text-deck-muted md:text-xl">
      Start in the <span class="font-semibold text-deck-blue">center</span> for cluster incidents —
      then pick the corner that answers your next question.
    </p>
  </div>
</Slide>
