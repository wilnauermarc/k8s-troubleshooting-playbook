---
import Slide from '../ui/Slide.astro';
import BranchTree from '../ui/BranchTree.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s28b-tree-crashloop-exit"
  chapter="Decision Trees"
  title="CrashLoop — Exit Code Path"
  track="core"
  notes="Exit 0 with Always restart often means a one-shot/wrong command exiting cleanly. Liveness failure: kubelet terminates the container (SIGTERM then SIGKILL after grace) — Unhealthy Events; exit may be 143 or 137, never Reason=OOMKilled. Exit 1 → app/config. Empty logs → --previous."
>
  <div class="stagger space-y-6">
    <BranchTree
      title="Not OOM — what is the exit code?"
      branches={[
        {
          question: 'Exit 0 + Always restart?',
          yes: 'Process exited cleanly',
          yesHint: 'Wrong command / one-shot / completed Job-like process',
          no: 'Check exit 1 / 126 / 127 / other',
          noHint: 'Also scan Unhealthy liveness Events',
        },
        {
          question: 'Unhealthy liveness Events?',
          yes: 'Probe killing a living process',
          yesHint: 'Fix path/timing or add startupProbe',
          no: 'Config / secret / env error in logs?',
          noHint: 'Then test DNS + TCP from a debug pod',
        },
      ]}
    />
    <Callout type="tip">
      Liveness kills go SIGTERM → SIGKILL after the grace period — exit 143 <em>or</em> 137, never <code class="text-deck-cyan">Reason: OOMKilled</code>. Check Events, not only the exit code.
    </Callout>
  </div>
</Slide>
