---
import Slide from '../ui/Slide.astro';
import Matrix from '../ui/Matrix.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s13b-symptom-layer-map"
  chapter="Rules & Models"
  title="Symptom → Layer Map"
  track="core"
  notes="Orientation table. First classify, then open the matching decision tree or layer chapter."
>
  <div class="stagger flex flex-col gap-6">
    <Matrix
      headers={['Symptom', 'Likely layer', 'First check']}
      rows={[
        ['Pending', 'Scheduling / PVC / image / init', 'describe → FailedScheduling Events'],
        ['Running + Ready=False', 'Probes / startup / app health', 'describe Conditions + probe lines'],
        ['Service up, no traffic', 'Selectors / Ready / EndpointSlice', 'get endpoints / endpointslices'],
        ['NXDOMAIN / lookup fail', 'DNS / CoreDNS / NetPol :53', 'nslookup from debug pod'],
        ['OOMKilled', 'Limits / leak / burst', 'describe Last State + top / metrics'],
        ['CrashLoopBackOff', 'Container / config / probe', 'logs --previous + exit code'],
      ]}
    />
    <Callout type="framework">
      Classify first. Commands second.
    </Callout>
  </div>
</Slide>
