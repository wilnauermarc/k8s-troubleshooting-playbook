---
import Slide from '../ui/Slide.astro';
import Callout from '../ui/Callout.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s22b-layer-containers-commands"
  chapter="Layers"
  title="Containers — Commands"
  notes="Container forensics: logs --previous, describe Last State, exec or kubectl debug. Myth: empty logs mean nothing — use --previous and describe Last State."
>
  <div class="stagger flex flex-col gap-6">
    <section>
      <h3 class="mb-3 font-display text-sm font-semibold uppercase tracking-wider text-deck-cyan">Typical commands</h3>
      <CodeBlock
        lang="bash"
        caption="Container forensics"
        code={`kubectl logs <pod> -n <ns> -c <container> --previous
kubectl describe pod <pod> -n <ns>   # Last State, Restart Count
kubectl exec -it <pod> -n <ns> -c <container> -- sh
kubectl debug -it <pod> -n <ns> --image=busybox --target=<container>`}
      />
    </section>

    <Callout type="myth">
      Empty logs mean nothing happened. The crashing instance may be gone — use <code class="text-deck-cyan/90">--previous</code> and describe Last State.
    </Callout>

    <div class="flex flex-wrap items-center gap-2 border-t border-deck-border/60 pt-4">
      <Pill tone="amber">Decision hint</Pill>
      <span class="text-lg text-deck-muted">Restart count rising → previous logs + exit reason before changing the Deployment.</span>
    </div>
  </div>
</Slide>
