---
import Slide from '../ui/Slide.astro';
import BranchTree from '../ui/BranchTree.astro';
import Callout from '../ui/Callout.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s41c-node-net-after-reboot"
  chapter="Failure Patterns"
  title="Node Networking After Hard Reboot"
  track="core"
  notes="Pattern, not a distro fix. Network looks broken after unexpected reboot — verify node identity/addressing before CNI, iptables, or conntrack. Never lead with iptables -F."
>
  <div class="stagger flex flex-col gap-6">
    <div class="flex flex-wrap items-center gap-2">
      <Pill tone="rose">network unreachable</Pill>
      <Pill tone="amber">Hard reboot</Pill>
      <Pill tone="cyan">Node IP sanity</Pill>
    </div>

    <BranchTree
      title="Pod → network unreachable"
      branches={[
        {
          question: 'Node IP matches reality?',
          yes: 'Continue normal path',
          yesHint: 'CNI → routes → iptables/nft → conntrack → upstream',
          no: 'Node addressing suspect',
          noHint: 'Reported IP ≠ interface / route / expected net',
        },
      ]}
    />

    <Callout type="rule">
      Before blaming the app or CNI: does Kubernetes’ view of the node still match the host’s address and default route?
    </Callout>
  </div>
</Slide>
