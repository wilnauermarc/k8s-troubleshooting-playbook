---
import Slide from '../ui/Slide.astro';
import Flow from '../ui/Flow.astro';
import CodeBlock from '../ui/CodeBlock.astro';
---

<Slide
  id="s38c-dns-fastpath"
  chapter="Failure Patterns"
  title="DNS Fast-Path — Four Checks"
  track="core"
  notes="Concrete sequence for beginners. Stop when a step fails — that step is your layer."
>
  <div class="stagger grid items-start gap-6 lg:grid-cols-2">
    <Flow
      nodes={[
        { label: '1. cat /etc/resolv.conf in the Pod', kind: 'start', hint: 'nameserver + search + ndots' },
        { label: '2. nslookup from a debug pod', kind: 'action', hint: 'short name vs FQDN' },
        { label: '3. CoreDNS pods Running + slices', kind: 'action', hint: 'kube-system' },
        { label: '4. CoreDNS logs', kind: 'ok', hint: 'forward / NXDOMAIN / timeout' },
      ]}
    />
    <CodeBlock
      caption="One command per check"
      code={`kubectl exec POD -n NS -- cat /etc/resolv.conf

kubectl run -it --rm dnsdebug --image=busybox:1.36 \\
  --restart=Never -- \\
  nslookup kubernetes.default.svc.cluster.local

kubectl get pods -n kube-system -l k8s-app=kube-dns
kubectl get endpointslices -n kube-system \\
  -l kubernetes.io/service-name=kube-dns

kubectl logs -n kube-system -l k8s-app=kube-dns \\
  --tail=50`}
    />
  </div>
</Slide>
