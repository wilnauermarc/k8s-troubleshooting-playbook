---
import Slide from '../ui/Slide.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s47b-incident-secret-fix"
  chapter="Production Incidents"
  title="Missing Secret — Fix & Prevent"
  notes="Root cause: Deployment references db-credentials-v3; External Secrets sync failed — Secret never created. Fix: repair ExternalSecret → re-sync. Prevent: deploy gate checks Secret exists; blue/green with secret pre-stage."
>
  <div class="stagger flex flex-col gap-8">
    <Callout type="tip" title="Root cause">
      Deployment references <code class="text-deck-cyan">db-credentials-v3</code>; External Secrets sync failed — Secret never created.
    </Callout>

    <CodeBlock
      caption="Events before logs"
      code={`kubectl describe pod api-5d8f7 | grep -A3 Events
kubectl get externalsecret db-credentials -o yaml
kubectl get secret db-credentials-v3   # NotFound`}
    />

    <div class="grid gap-5 md:grid-cols-2">
      <div class="rounded-xl border border-deck-cyan/40 bg-deck-cyan/5 p-6">
        <div class="font-display text-xl font-bold text-deck-cyan">Fix</div>
        <p class="mt-2 text-lg text-deck-text/90">Repair ExternalSecret → re-sync; restore from vault if needed.</p>
      </div>
      <div class="rounded-xl border border-deck-amber/40 bg-deck-amber/5 p-6">
        <div class="font-display text-xl font-bold text-deck-amber">Prevent</div>
        <p class="mt-2 text-lg text-deck-text/90">Deploy gate checks Secret exists; never delete old secret until consumers updated.</p>
      </div>
    </div>
  </div>
</Slide>
