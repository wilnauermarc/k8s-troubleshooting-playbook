---
import Slide from '../ui/Slide.astro';
import ArchRow from '../ui/ArchRow.astro';
import SignalGrid from '../ui/SignalGrid.astro';
import Callout from '../ui/Callout.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s40-net-ingress-gateway"
  chapter="Failure Patterns"
  title="Ingress vs Gateway API"
  notes="Edge architecture: client → LB → ingress/gateway controller → Service → pods. Split responsibility: Ingress/HTTPRoute is config; controller is data plane (nginx, traefik, istio). Gateway API adds GatewayClass, Gateway, HTTPRoute — check parentRefs and Accepted conditions. Common: wrong ingressClassName, host rule mismatch, path Type Prefix vs Exact. 502 often means empty/not-ready EndpointSlice upstream. Next slide: TLS and cert-manager."
>
  <div class="stagger flex flex-col gap-8">
    <div class="flex flex-wrap items-center gap-2">
      <Pill tone="cyan">Ingress</Pill>
      <Pill tone="violet">Gateway API</Pill>
      <Pill tone="rose">502 / 503</Pill>
    </div>

    <ArchRow
      boxes={[
        { title: 'Client', subtitle: 'HTTPS', tone: 'cyan' },
        { title: 'LB', subtitle: 'external', tone: 'blue' },
        { title: 'Controller', subtitle: 'nginx / istio', tone: 'violet' },
        { title: 'Service', subtitle: 'EndpointSlice', tone: 'amber' },
        { title: 'Pods', subtitle: 'app', tone: 'rose' },
      ]}
    />

    <SignalGrid
      class="lg:grid-cols-2"
      items={[
        { label: '502 Bad Gateway', value: 'Controller OK, backend addresses empty/unhealthy' },
        { label: '404 on valid path', value: 'Host/path rule mismatch or wrong ingress class' },
        { label: '504 Timeout', value: 'App slow or proxy read timeout' },
        { label: 'Gateway API', value: 'Check Accepted=True on parent Gateway first' },
      ]}
    />

    <Callout type="framework" title="Edge debug order">
      DNS → LB reachable → Ingress/Gateway rules → EndpointSlice → Pod logs
    </Callout>
  </div>
</Slide>
