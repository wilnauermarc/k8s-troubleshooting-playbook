---
import Slide from '../ui/Slide.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s55-cheatsheets"
  chapter="Reference"
  title="Cheat Sheet — First 60 Seconds"
  notes="This is the slide attendees photograph. First 60 seconds: wide get, then narrow describe. These are starting points — the lifecycle drives what you run next. Next slides: status meanings and networking quick path."
>
  <div class="stagger flex flex-col gap-8">
    <CodeBlock
      caption="First 60 seconds — any broken workload"
      code={`kubectl get pods,events -n <ns> --sort-by='.lastTimestamp'
kubectl describe pod <pod> | less          # Events first
kubectl logs <pod> --previous               # if restarted
kubectl get endpoints,svc -n <ns>`}
    />

    <Callout type="rule">
      Wide get → narrow describe → logs --previous if restarted → endpoints if traffic issue.
    </Callout>
  </div>
</Slide>
