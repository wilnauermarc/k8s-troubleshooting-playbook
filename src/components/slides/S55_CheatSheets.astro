---
import Slide from '../ui/Slide.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s55-cheatsheets"
  chapter="Reference"
  title="Cheat Sheet — First 60 Seconds"
  track="reference"
  notes="Photograph slide. Wide get → describe → logs --previous → EndpointSlice if traffic issue."
>
  <div class="stagger flex flex-col gap-8">
    <CodeBlock
      caption="First 60 seconds — any broken workload"
      code={`kubectl get pods -n <ns> -o wide
kubectl get events -n <ns> --sort-by='.lastTimestamp'
kubectl describe pod <pod> | less          # Events + Conditions
kubectl logs <pod> --previous               # if restarted / CrashLoop
kubectl get endpointslices,svc -n <ns>`}
    />

    <Callout type="rule">
      Wide get → narrow describe → logs --previous if restarted → EndpointSlice if traffic issue.
    </Callout>
  </div>
</Slide>
