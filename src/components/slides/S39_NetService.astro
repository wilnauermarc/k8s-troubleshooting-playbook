---
import Slide from '../ui/Slide.astro';
import ServicePath from '../ui/ServicePath.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s39-net-service"
  chapter="Failure Patterns"
  title="Service: Selectors & EndpointSlices"
  track="core"
  notes="Walk left to right. Not Ready pods are excluded from Service traffic via EndpointSlice conditions — even if STATUS=Running."
>
  <div class="stagger flex flex-col items-center gap-6">
    <ServicePath />
    <Callout type="rule" class="max-w-3xl">
      No Ready addresses in EndpointSlice = no traffic path. Fix labels and readiness before blaming CNI.
    </Callout>
  </div>
</Slide>
