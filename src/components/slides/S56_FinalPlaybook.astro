---
import Slide from '../ui/Slide.astro';
import LifecycleRing from '../ui/LifecycleRing.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s56-final-playbook"
  chapter="Synthesis"
  title="Final Playbook — The Loop"
  notes="Leave them with the ring. Mantras next; pyramid/onion/signals on the models slide."
>
  <div class="stagger flex flex-col items-center gap-6">
    <LifecycleRing class="max-w-md" />
    <div class="grid w-full max-w-3xl gap-3 sm:grid-cols-2">
      <Callout type="rule">Running ≠ Healthy</Callout>
      <Callout type="rule">Ready ≠ Alive</Callout>
      <Callout type="rule">Observe before changing</Callout>
      <Callout type="rule">One hypothesis · Validate · Prevent</Callout>
    </div>
  </div>
</Slide>
