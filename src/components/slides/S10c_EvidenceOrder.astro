---
import Slide from '../ui/Slide.astro';
import Flow from '../ui/Flow.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s10c-evidence-order"
  chapter="Rules & Models"
  title="Read Evidence in Order"
  track="core"
  notes="Default order — skip only with a reason. CrashLoop often makes logs --previous the fastest win after describe. Exec/debug last."
>
  <div class="stagger flex flex-col gap-8">
    <Flow
      nodes={[
        { label: '1. kubectl describe', kind: 'start', hint: 'Events + Conditions + Reasons' },
        { label: '2. Events / Conditions', kind: 'action', hint: 'WHAT Kubernetes tried' },
        { label: '3. logs / logs --previous', kind: 'action', hint: 'WHY the process failed' },
        { label: '4. Object YAML / spec', kind: 'action', hint: 'Desired state mismatches' },
        { label: '5. exec / debug (only if needed)', kind: 'bad', hint: 'Invasive — last resort' },
      ]}
    />
    <Callout type="rule">
      Default path: describe → Events/Conditions → logs → YAML → then debug. Reorder when the symptom already points at logs (CrashLoop).
    </Callout>
  </div>
</Slide>
