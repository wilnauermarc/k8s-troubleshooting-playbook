---
import Slide from '../ui/Slide.astro';
import Flow from '../ui/Flow.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s10c-evidence-order"
  chapter="Rules & Models"
  title="Read Evidence in Order"
  track="core"
  notes="Memorize this order. Exec/debug last — they destroy evidence and waste time when describe already answers."
>
  <div class="stagger flex flex-col gap-8">
    <Flow
      nodes={[
        { label: '1. kubectl describe', kind: 'start', hint: 'Events + conditions + reasons' },
        { label: '2. Events', kind: 'action', hint: 'WHAT the control plane tried' },
        { label: '3. logs / logs --previous', kind: 'action', hint: 'WHY the process failed' },
        { label: '4. Object YAML / spec', kind: 'action', hint: 'Desired state mismatches' },
        { label: '5. exec / debug (only if needed)', kind: 'bad', hint: 'Last resort — invasive' },
      ]}
    />
    <Callout type="rule">
      Wide get → narrow describe → logs → YAML → then debug. Skip steps only when you already know the layer.
    </Callout>
  </div>
</Slide>
