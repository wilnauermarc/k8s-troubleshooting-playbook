---
import Slide from '../ui/Slide.astro';
import Goals from '../ui/Goals.astro';
import Lifecycle from '../ui/Lifecycle.astro';
---

<Slide
  id="s42-kubectl-philosophy"
  chapter="kubectl by Intention"
  title="kubectl by Intention"
  variant="chapter"
  track="core"
  notes="Commands match questions. Observe/Locate/Narrow/Verify map to get/describe/logs/rollout."
>
  <div class="stagger flex max-w-3xl flex-col items-center gap-8 text-center">
    <h2 class="font-display text-4xl font-extrabold text-deck-text md:text-5xl">kubectl by Intention</h2>
    <Goals
      class="w-full text-left"
      goals={[
        'Pick a command from the question you are answering',
        'Know when NOT to use exec, port-forward, or top',
        'Follow evidence order before invasive tools',
      ]}
    />
    <Lifecycle class="justify-center" steps={['Observe', 'Locate', 'Narrow', 'Verify']} active={0} />
  </div>
</Slide>
