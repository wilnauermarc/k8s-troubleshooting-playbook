---
import Slide from '../ui/Slide.astro';
import Flow from '../ui/Flow.astro';
import Callout from '../ui/Callout.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s41-net-policy"
  chapter="Failure Patterns"
  title="NetworkPolicy: Default-Deny Mental Model"
  track="core"
  notes="Allow-all until a deny policy applies. Ingress deny ≠ egress deny — check policyTypes. Default-deny egress without DNS allow breaks name resolution for selected workloads — not automatically a whole-cluster outage."
>
  <div class="stagger flex flex-col gap-8">
    <div class="flex flex-wrap items-center gap-2">
      <Pill tone="rose">Silent drop</Pill>
      <Pill tone="amber">policyTypes matter</Pill>
    </div>

    <Flow
      nodes={[
        { label: 'CNI enforces NetworkPolicy?', kind: 'start', hint: 'Calico/Cilium yes; some CNIs no-op' },
        { label: 'default-deny ingress and/or egress?', kind: 'decision', hint: 'separate dimensions' },
        { label: 'Only explicit allow rules pass', kind: 'action' },
        { label: 'Symptom: timeout (not ICMP unreachable)', kind: 'bad' },
      ]}
    />

    <div class="grid gap-4 md:grid-cols-2">
      <Callout type="rule" title="Ingress vs egress">
        Default-deny <em>ingress</em> blocks inbound; default-deny <em>egress</em> blocks outbound. Each needs its own allow rules.
      </Callout>
      <Callout type="danger" title="DNS under egress deny">
        Default-deny egress without UDP/TCP 53 to CoreDNS breaks name resolution for <em>selected</em> workloads — not automatically cluster-wide.
      </Callout>
    </div>
  </div>
</Slide>
