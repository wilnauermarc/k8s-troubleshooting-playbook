---
import Slide from '../ui/Slide.astro';
import OnionDraw from '../ui/OnionDraw.astro';
---

<Slide
  id="s12-onion"
  chapter="Rules & Models"
  title="The Kubernetes Onion — Outer Layers"
  notes="Concentric rings outermost → inward. Infra wraps cluster wraps control plane… Peel one layer at a time. Inner layers next slide."
>
  <div class="stagger flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:gap-10">
    <div class="flex-1">
      <OnionDraw
        layers={[
          { name: 'Infrastructure', color: '#fb7185' },
          { name: 'Cluster', color: '#fbbf24' },
          { name: 'Control Plane', color: '#2dd4bf' },
          { name: 'Nodes', color: '#60a5fa' },
          { name: 'Scheduling', color: '#a78bfa' },
          { name: 'Deployments', color: '#2dd4bf' },
          { name: 'ReplicaSets', color: '#60a5fa' },
        ]}
      />
    </div>
    <p class="max-w-xs text-center text-xl leading-relaxed text-deck-muted lg:text-left">
      Each ring has its own signals and owners.
      <span class="mt-3 block font-display font-semibold text-deck-cyan">Don’t skip layers.</span>
    </p>
  </div>
</Slide>
