---
import Slide from '../ui/Slide.astro';
import BranchTree from '../ui/BranchTree.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s29-tree-503"
  chapter="Decision Trees"
  title="HTTP 503 — First Branch"
  track="core"
  notes="503 with Running pods is usually no Ready addresses in EndpointSlice — not 'Kubernetes is down'."
>
  <div class="stagger space-y-8">
    <BranchTree
      title="Users get HTTP 503"
      branches={[
        {
          question: 'Service has Ready addresses?',
          yes: 'Check Ingress / Gateway / LB next',
          no: 'Selector mismatch or no Ready pods',
          noHint: 'kubectl get endpointslices -l kubernetes.io/service-name=NAME',
        },
        {
          question: 'Pods Ready?',
          yes: 'Port / targetPort mismatch?',
          no: 'Fix readiness probe or app health',
        },
      ]}
    />
    <Callout type="rule">
      Running ≠ in EndpointSlice. Only <strong>Ready</strong> pods receive Service traffic.
    </Callout>
  </div>
</Slide>
