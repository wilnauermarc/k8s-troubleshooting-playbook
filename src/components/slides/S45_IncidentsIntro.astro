---
import Slide from '../ui/Slide.astro';
import Goals from '../ui/Goals.astro';
import Lifecycle from '../ui/Lifecycle.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s45-incidents-intro"
  chapter="Production Incidents"
  title="Production Incidents — Practice"
  variant="chapter"
  track="practice"
  notes="Practice section. Predict root cause before opening the Fix slide. Each incident uses: Symptom → wrong assumption → discriminating check → root cause → fix → validate → prevent."
>
  <div class="stagger flex max-w-3xl flex-col items-center gap-8 text-center">
    <h2 class="font-display text-4xl font-extrabold leading-tight text-deck-text md:text-5xl">
      Production Incidents
    </h2>
    <p class="max-w-xl text-lg leading-relaxed text-deck-muted">
      Work each case as a study drill — cover the Fix slide until you have a hypothesis.
    </p>
    <Goals
      class="w-full text-left"
      goals={[
        'Spot the first wrong assumption under pressure',
        'Name the fastest discriminating check',
        'Write fix + validate + prevent for the pattern',
      ]}
    />
    <Lifecycle
      steps={['Symptom', 'Check', 'Cause', 'Fix', 'Validate', 'Prevent']}
      active={0}
      class="justify-center"
    />
    <div class="flex flex-wrap justify-center gap-2">
      <Pill tone="rose">503 / EndpointSlice</Pill>
      <Pill tone="amber">Secret</Pill>
      <Pill tone="cyan">Affinity</Pill>
      <Pill tone="blue">OOM</Pill>
      <Pill tone="violet">Gateway</Pill>
      <Pill tone="muted">DNS · NetPol · Node reboot · PVC</Pill>
    </div>
  </div>
</Slide>
