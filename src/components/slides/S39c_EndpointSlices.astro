---
import Slide from '../ui/Slide.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s39c-endpointslices"
  chapter="Failure Patterns"
  title="EndpointSlices — Backend Conditions"
  track="core"
  notes="Prefer EndpointSlice over legacy Endpoints. Slices partition backends and expose ready/serving/terminating conditions — not just a flat ready list. kube-proxy uses slices for Service routing."
>
  <div class="stagger flex flex-col gap-6">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-deck-border bg-deck-panel p-5">
        <div class="font-display text-lg font-bold text-deck-muted">Endpoints (legacy)</div>
        <p class="mt-2 text-lg text-deck-muted">Older aggregate API — still works, prefer slices.</p>
      </div>
      <div class="rounded-xl border border-deck-border bg-deck-panel p-5">
        <div class="font-display text-lg font-bold text-deck-amber">EndpointSlice</div>
        <p class="mt-2 text-lg text-deck-muted">Scalable, partitioned backends with ready / serving / terminating conditions.</p>
      </div>
    </div>

    <CodeBlock
      caption="Service exists but no traffic — prefer slices"
      code={`kubectl get endpointslices -n NS -l kubernetes.io/service-name=SERVICE -o wide
# Inspect conditions: ready, serving, terminating
# Empty / not ready → selector mismatch or readiness probe`}
    />

    <Callout type="rule">
      Prefer <code class="text-deck-cyan">EndpointSlice</code>. Empty or not-ready addresses → fix labels/probes before blaming CNI.
    </Callout>
  </div>
</Slide>
