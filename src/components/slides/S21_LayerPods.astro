---
import Slide from '../ui/Slide.astro';
import Matrix from '../ui/Matrix.astro';
---

<Slide
  id="s21-layer-pods"
  chapter="Layers"
  title="Pods"
  notes="Phase is coarse; conditions (PodScheduled, Initialized, Ready, ContainersReady) are precise. Running ≠ Ready. Init containers run before app containers. restartPolicy affects failure behavior. Commands on next slide."
>
  <div class="stagger flex flex-col gap-6">
    <section>
      <h3 class="mb-3 font-display text-sm font-semibold uppercase tracking-wider text-deck-cyan">Purpose</h3>
      <p class="text-lg leading-relaxed text-deck-text/90 md:text-xl">
        Smallest schedulable unit — one or more containers sharing network, storage, and lifecycle context.
      </p>
    </section>

    <section>
      <h3 class="mb-3 font-display text-sm font-semibold uppercase tracking-wider text-deck-rose">Typical failures</h3>
      <ul class="space-y-2 text-lg text-deck-text/90 md:text-xl">
        <li>• Not yet scheduled or volumes not mounted</li>
        <li>• Init container blocking app start</li>
        <li>• Probes failing while phase is Running</li>
        <li>• Finalizers or volume detach delaying termination</li>
      </ul>
    </section>

    <Matrix
      headers={['Phase / condition', 'Observable symptom']}
      rows={[
        ['Pending', 'Not yet scheduled or volumes not mounted'],
        ['Init:0/1', 'Init container blocking app start'],
        ['Running + Ready=False', 'Probes failing, not receiving traffic'],
      ]}
    />
  </div>
</Slide>
