---
import Slide from '../ui/Slide.astro';
import Flow from '../ui/Flow.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s28-tree-crashloop"
  chapter="Decision Trees"
  title="CrashLoopBackOff — First Moves"
  notes="CrashLoop is backoff, not diagnosis. Always inspect Restart Count + Last State before logs."
>
  <div class="stagger space-y-8">
    <Flow
      nodes={[
        { label: 'CrashLoopBackOff', kind: 'bad' },
        { label: 'describe pod → Restart Count + Last State', kind: 'start' },
        { label: 'Last State.Reason = OOMKilled?', kind: 'decision', hint: 'Exit 137 = SIGKILL; confirm Reason' },
        { label: 'Yes → raise limit or fix leak', kind: 'action' },
      ]}
    />
    <Callout type="tip">
      Exit 137 means SIGKILL — often OOM, but verify <code class="text-deck-cyan">Reason: OOMKilled</code>. Otherwise check exit code and <code class="text-deck-cyan">logs --previous</code>.
    </Callout>
  </div>
</Slide>
