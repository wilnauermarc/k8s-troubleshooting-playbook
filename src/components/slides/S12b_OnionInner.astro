---
import Slide from '../ui/Slide.astro';
import OnionDraw from '../ui/OnionDraw.astro';
---

<Slide
  id="s12b-onion-inner"
  chapter="Rules & Models"
  title="The Kubernetes Onion — Inner Layers"
  notes="Where most day-to-day debugging lives. Platform can be perfect while the app lies — validate response bodies, not just pod phase."
>
  <div class="stagger flex flex-col items-center gap-6 lg:flex-row lg:items-center lg:gap-10">
    <div class="flex-1">
      <OnionDraw
        layers={[
          { name: 'Pods', color: '#2dd4bf' },
          { name: 'Containers', color: '#60a5fa' },
          { name: 'Storage', color: '#fbbf24' },
          { name: 'Networking', color: '#a78bfa' },
          { name: 'Application', color: '#fb7185' },
          { name: 'Business Logic', color: '#2dd4bf' },
        ]}
      />
    </div>
    <p class="max-w-xs text-center text-xl leading-relaxed text-deck-muted lg:text-left">
      Most incidents live here.
      <span class="mt-3 block font-display font-semibold text-deck-cyan">Platform healthy ≠ app healthy.</span>
    </p>
  </div>
</Slide>
