---
import Slide from '../ui/Slide.astro';
import SignalGrid from '../ui/SignalGrid.astro';
import Callout from '../ui/Callout.astro';
import Pill from '../ui/Pill.astro';
---

<Slide
  id="s34-oom-killed"
  chapter="Failure Patterns"
  title="OOMKilled — Container Memory Limit"
  track="core"
  notes="Proof is Last State.Reason: OOMKilled. Exit 137 = SIGKILL only — verify Reason before concluding OOM. CPU throttle ≠ OOM. Evicted is node pressure."
>
  <div class="stagger flex flex-col gap-6">
    <div class="flex flex-wrap items-center gap-2">
      <Pill tone="rose">Reason: OOMKilled</Pill>
      <Pill tone="muted">Exit 137 = SIGKILL</Pill>
    </div>

    <SignalGrid
      items={[
        { label: 'What happened', value: 'Container hit memory limit — cgroup killed the process' },
        { label: 'Proof', value: 'Last State.Reason: OOMKilled (exit 137 alone is not enough)' },
        { label: 'Not OOM', value: 'CPU throttle — pod stays Running; or SIGKILL from elsewhere' },
        { label: 'Fix path', value: 'Raise limit · fix leak · right-size requests/limits' },
      ]}
    />

    <Callout type="rule">
      Exit 137 = SIGKILL. Verify <code class="text-deck-cyan">Reason: OOMKilled</code> before concluding OOM. Different from Evicted (node housekeeping).
    </Callout>
  </div>
</Slide>
