---
import Slide from '../ui/Slide.astro';
import Callout from '../ui/Callout.astro';
---

<Slide
  id="s10-golden-rules"
  chapter="Rules & Models"
  title="Golden Rules (1/2)"
  track="core"
  notes="Prefer cheapest high-signal evidence first — often Events and Conditions; CrashLoop may make logs --previous the fastest win. Events explain Kubernetes actions; logs explain application failures. Hypothesize before the next command."
>
  <div class="stagger flex flex-col gap-5">
    <Callout type="rule" title="Cheapest high-signal evidence first">
      Start with the highest-signal evidence: Events, Conditions, and previous logs. Events explain Kubernetes actions; logs explain process/application failures.
    </Callout>

    <Callout type="rule" title="Hypothesize">
      Write down what you think is wrong before running the next command.
    </Callout>

    <Callout type="rule" title="Eliminate Layers">
      Rule out infra and cluster before diving into application code.
    </Callout>

    <Callout type="rule" title="Outside-In / Bottom-Up">
      Start from user impact, eliminate from infrastructure upward.
    </Callout>
  </div>
</Slide>
