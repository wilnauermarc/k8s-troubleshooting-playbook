---
interface Props {
  tone?: 'cyan' | 'amber' | 'rose' | 'blue' | 'muted' | 'violet';
  class?: string;
}

const { tone = 'cyan', class: className = '' } = Astro.props;

const tones = {
  cyan: 'border-deck-cyan/30 bg-deck-cyan/10 text-deck-cyan',
  amber: 'border-deck-amber/30 bg-deck-amber/10 text-deck-amber',
  rose: 'border-deck-rose/30 bg-deck-rose/10 text-deck-rose',
  blue: 'border-deck-blue/30 bg-deck-blue/10 text-deck-blue',
  muted: 'border-deck-border bg-deck-panel text-deck-muted',
  violet: 'border-deck-violet/30 bg-deck-violet/10 text-deck-violet',
}[tone];
---

<span class:list={['inline-flex items-center rounded-md border px-3 py-1 text-sm font-medium', tones, className]}>
  <slot />
</span>
