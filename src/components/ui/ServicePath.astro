---
/** Client → Service → Endpoints → Pods packet path with Ready gate. */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 800 280"
  class:list={['mx-auto h-auto w-full max-w-5xl', className]}
  role="img"
  aria-label="Traffic path from client through Service and Endpoints to Ready pods"
>
  <!-- Client -->
  <rect x="20" y="90" width="130" height="100" rx="16" fill="#0d1526" stroke="#2dd4bf" stroke-width="2.5" />
  <text x="85" y="140" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="18" font-weight="700">Client</text>
  <text x="85" y="165" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="13">curl / app</text>

  <text x="175" y="145" fill="#8b9bb8" font-size="28">→</text>

  <!-- Service -->
  <rect x="200" y="90" width="140" height="100" rx="16" fill="#0d1526" stroke="#60a5fa" stroke-width="2.5" />
  <text x="270" y="135" text-anchor="middle" fill="#60a5fa" font-family="Sora, sans-serif" font-size="18" font-weight="700">Service</text>
  <text x="270" y="160" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="13">ClusterIP</text>
  <text x="270" y="178" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="12">+ selector</text>

  <text x="360" y="145" fill="#8b9bb8" font-size="28">→</text>

  <!-- Endpoints gate -->
  <rect x="390" y="70" width="160" height="140" rx="16" fill="#0d1526" stroke="#fbbf24" stroke-width="2.5" />
  <text x="470" y="110" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="18" font-weight="700">Endpoints</text>
  <text x="470" y="140" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="14">Only Ready pods</text>
  <rect x="415" y="155" width="110" height="32" rx="8" fill="#fbbf24" fill-opacity="0.12" stroke="#fbbf24" stroke-width="1.5" />
  <text x="470" y="176" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="13" font-weight="700">READY GATE</text>

  <text x="570" y="145" fill="#8b9bb8" font-size="28">→</text>

  <!-- Pods -->
  <g>
    <rect x="600" y="40" width="170" height="70" rx="12" fill="#0d1526" stroke="#2dd4bf" stroke-width="2" />
    <text x="685" y="70" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="15" font-weight="700">Pod A · Ready</text>
    <text x="685" y="92" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="12">in Endpoints ✓</text>

    <rect x="600" y="125" width="170" height="70" rx="12" fill="#0d1526" stroke="#fb7185" stroke-width="2" stroke-dasharray="6 4" />
    <text x="685" y="155" text-anchor="middle" fill="#fb7185" font-family="Sora, sans-serif" font-size="15" font-weight="700">Pod B · Not Ready</text>
    <text x="685" y="177" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="12">excluded ✗</text>

    <rect x="600" y="210" width="170" height="50" rx="12" fill="#0d1526" stroke="#1a2744" stroke-width="2" />
    <text x="685" y="240" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="13">targetPort must match</text>
  </g>
</svg>
