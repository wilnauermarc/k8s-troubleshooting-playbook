---
/** Mini signal triangle for synthesis slides. */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 320 280"
  class:list={['mx-auto h-auto w-full max-w-xs', className]}
  role="img"
  aria-label="Mini signal triangle"
>
  <polygon points="160,24 280,230 40,230" fill="#2dd4bf" fill-opacity="0.08" stroke="#2dd4bf" stroke-width="2" />
  <circle cx="160" cy="145" r="36" fill="#0d1526" stroke="#60a5fa" stroke-width="2.5" />
  <text x="160" y="142" text-anchor="middle" fill="#60a5fa" font-family="Sora, sans-serif" font-size="12" font-weight="700">Events</text>
  <text x="160" y="158" text-anchor="middle" fill="#e8eef9" font-family="Sora, sans-serif" font-size="10" letter-spacing="0.1em">WHAT</text>

  <text x="160" y="18" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="12" font-weight="700">Metrics · WHEN</text>
  <text x="48" y="255" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="12" font-weight="700">Logs · WHY</text>
  <text x="272" y="255" text-anchor="middle" fill="#a78bfa" font-family="Sora, sans-serif" font-size="12" font-weight="700">Traces · WHERE</text>
</svg>
