---
interface Props {
  items: { label: string; value: string; tone?: 'cyan' | 'amber' | 'rose' | 'blue' | 'violet' }[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const tones: Record<string, { border: string; label: string; glow: string }> = {
  cyan: { border: 'border-deck-cyan/35', label: 'text-deck-cyan', glow: 'bg-deck-cyan/5' },
  amber: { border: 'border-deck-amber/35', label: 'text-deck-amber', glow: 'bg-deck-amber/5' },
  rose: { border: 'border-deck-rose/35', label: 'text-deck-rose', glow: 'bg-deck-rose/5' },
  blue: { border: 'border-deck-blue/35', label: 'text-deck-blue', glow: 'bg-deck-blue/5' },
  violet: { border: 'border-deck-violet/35', label: 'text-deck-violet', glow: 'bg-deck-violet/5' },
};

const cycle = ['cyan', 'amber', 'blue', 'rose'] as const;
---

<div class:list={['grid gap-4 sm:grid-cols-2 lg:grid-cols-4', className]}>
  {
    items.map((item, i) => {
      const t = tones[item.tone ?? cycle[i % cycle.length]];
      return (
        <div class:list={['rounded-xl border p-5', t.border, t.glow]}>
          <div class:list={['mb-2 font-display text-sm font-semibold uppercase tracking-wider', t.label]}>
            {item.label}
          </div>
          <div class="text-base leading-snug text-deck-text/90 md:text-lg">{item.value}</div>
        </div>
      );
    })
  }
</div>
