---
interface Props {
  code: string;
  lang?: string;
  caption?: string;
  class?: string;
}

const { code, lang = 'bash', caption, class: className = '' } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-xl border border-deck-border bg-[#060a12]', className]}>
  <div class="flex items-center gap-3 border-b border-deck-border px-4 py-2.5">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-deck-rose/70"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-deck-amber/70"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-deck-cyan/70"></span>
    </span>
    <span class="font-mono text-xs uppercase tracking-wider text-deck-muted">{lang}</span>
    {caption && <span class="ml-auto text-sm text-deck-muted">{caption}</span>}
  </div>
  <pre class="overflow-x-auto p-5 font-mono text-[0.95rem] leading-relaxed text-deck-cyan/95 md:p-6 md:text-base lg:text-[1.05rem]"><code>{code.trim()}</code></pre>
</figure>
