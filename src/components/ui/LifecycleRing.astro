---
/**
 * Circular investigation lifecycle — projector-scale illustration.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const steps = [
  { label: 'Observe', angle: -90, color: '#2dd4bf' },
  { label: 'Locate', angle: -38.6, color: '#2dd4bf' },
  { label: 'Narrow', angle: 12.9, color: '#60a5fa' },
  { label: 'Verify', angle: 64.3, color: '#60a5fa' },
  { label: 'Fix', angle: 115.7, color: '#fbbf24' },
  { label: 'Validate', angle: 167.1, color: '#fbbf24' },
  { label: 'Prevent', angle: 218.6, color: '#a78bfa' },
];

const cx = 280;
const cy = 280;
const r = 175;

function pos(angleDeg: number, radius = r) {
  const rad = (angleDeg * Math.PI) / 180;
  return {
    x: cx + radius * Math.cos(rad),
    y: cy + radius * Math.sin(rad),
  };
}

function arcPath(fromAngle: number, toAngle: number, radius: number) {
  let end = toAngle;
  if (end <= fromAngle) end += 360;
  const start = pos(fromAngle, radius);
  const finish = pos(end, radius);
  const large = end - fromAngle > 180 ? 1 : 0;
  return `M ${start.x} ${start.y} A ${radius} ${radius} 0 ${large} 1 ${finish.x} ${finish.y}`;
}

const arcs = steps.map((step, i) => {
  const next = steps[(i + 1) % steps.length];
  const from = step.angle + 18;
  let to = next.angle - 18;
  if (to <= from) to += 360;
  return { d: arcPath(from, to, r), color: step.color };
});

const nodes = steps.map((step) => ({
  ...step,
  ...pos(step.angle),
}));
---

<svg
  viewBox="0 0 560 560"
  class:list={['mx-auto h-auto w-full max-w-xl', className]}
  role="img"
  aria-label="Investigation lifecycle ring: Observe through Prevent"
>
  <defs>
    <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2dd4bf" />
      <stop offset="45%" stop-color="#60a5fa" />
      <stop offset="75%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#a78bfa" />
    </linearGradient>
    <marker id="ring-arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <path d="M0,0 L6,3 L0,6 Z" fill="#2dd4bf" />
    </marker>
  </defs>

  <circle cx={cx} cy={cy} r={r} fill="none" stroke="url(#ring-grad)" stroke-width="3.5" stroke-opacity="0.45" />
  <circle cx={cx} cy={cy} r={r - 28} fill="#0d1526" stroke="#1a2744" stroke-width="2" />

  {
    arcs.map((arc) => (
      <path
        d={arc.d}
        fill="none"
        stroke={arc.color}
        stroke-width="2"
        stroke-opacity="0.55"
        marker-end="url(#ring-arr)"
      />
    ))
  }

  <text x={cx} y={cy - 10} text-anchor="middle" fill="#e8eef9" font-family="Sora, sans-serif" font-size="22" font-weight="700">
    Investigate
  </text>
  <text x={cx} y={cy + 18} text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="13" letter-spacing="0.16em">
    THEN REPEAT
  </text>

  {
    nodes.map((node) => (
      <g>
        <circle cx={node.x} cy={node.y} r="48" fill="#0d1526" stroke={node.color} stroke-width="2.5" />
        <text
          x={node.x}
          y={node.y + 5}
          text-anchor="middle"
          fill={node.color}
          font-family="Sora, sans-serif"
          font-size="13"
          font-weight="700"
        >
          {node.label}
        </text>
      </g>
    ))
  }

  <text x={cx} y="535" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="15">
    Clockwise under pressure — never skip Observe on a new failure
  </text>
</svg>
