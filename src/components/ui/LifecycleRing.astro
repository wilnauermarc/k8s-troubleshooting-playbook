---
/**
 * Circular investigation lifecycle — projector-scale illustration.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const steps = [
  { label: 'Observe', angle: -90 },
  { label: 'Locate', angle: -38.6 },
  { label: 'Narrow', angle: 12.9 },
  { label: 'Verify', angle: 64.3 },
  { label: 'Fix', angle: 115.7 },
  { label: 'Validate', angle: 167.1 },
  { label: 'Prevent', angle: 218.6 },
];

const cx = 280;
const cy = 280;
const r = 175;

function pos(angleDeg: number, radius = r) {
  const rad = (angleDeg * Math.PI) / 180;
  return {
    x: cx + radius * Math.cos(rad),
    y: cy + radius * Math.sin(rad),
  };
}
---

<svg
  viewBox="0 0 560 560"
  class:list={['mx-auto h-auto w-full max-w-xl', className]}
  role="img"
  aria-label="Investigation lifecycle ring: Observe through Prevent"
>
  <defs>
    <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2dd4bf" />
      <stop offset="50%" stop-color="#60a5fa" />
      <stop offset="100%" stop-color="#fbbf24" />
    </linearGradient>
  </defs>

  <circle cx={cx} cy={cy} r={r} fill="none" stroke="url(#ring-grad)" stroke-width="3" stroke-opacity="0.55" />
  <circle cx={cx} cy={cy} r={r - 28} fill="#0d1526" stroke="#1a2744" stroke-width="2" />

  <text x={cx} y={cy - 8} text-anchor="middle" fill="#e8eef9" font-family="Sora, sans-serif" font-size="22" font-weight="700">
    Investigate
  </text>
  <text x={cx} y={cy + 22} text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="14" letter-spacing="0.16em">
    THEN REPEAT
  </text>

  {
    steps.map((step, i) => {
      const p = pos(step.angle);
      const next = steps[(i + 1) % steps.length];
      const mid = pos((step.angle + next.angle + (next.angle < step.angle ? 360 : 0)) / 2, r);
      return (
        <g>
          <circle cx={p.x} cy={p.y} r="46" fill="#0d1526" stroke={i < 4 ? '#2dd4bf' : '#fbbf24'} stroke-width="2.5" />
          <text
            x={p.x}
            y={p.y + 5}
            text-anchor="middle"
            fill={i < 4 ? '#2dd4bf' : '#fbbf24'}
            font-family="Sora, sans-serif"
            font-size="13"
            font-weight="700"
          >
            {step.label}
          </text>
        </g>
      );
    })
  }

  <!-- Direction hint -->
  <text x={cx} y="535" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="15">
    Clockwise under pressure — never skip Observe on a new failure
  </text>
</svg>
