---
/**
 * Vertical decision / process flow — readable on a projector.
 */
interface Node {
  label: string;
  kind?: 'start' | 'decision' | 'action' | 'ok' | 'bad';
  hint?: string;
}

interface Props {
  nodes: Node[];
  class?: string;
}

const { nodes, class: className = '' } = Astro.props;

const kindClass: Record<string, string> = {
  start: 'flow-node-start',
  decision: 'flow-node-decision',
  action: 'flow-node-action',
  ok: 'flow-node-ok',
  bad: 'flow-node-bad',
};
---

<div class:list={['mx-auto flex w-full max-w-3xl flex-col items-stretch', className]}>
  {
    nodes.map((node, i) => (
      <>
        <div class:list={['flow-node', kindClass[node.kind ?? 'action']]}>
          {node.label}
          {node.hint && <div class="mt-1.5 font-sans text-sm font-normal text-deck-muted">{node.hint}</div>}
        </div>
        {i < nodes.length - 1 && (
          <div class="flow-arrow" aria-hidden="true">
            <svg width="20" height="28" viewBox="0 0 20 28" fill="none" class="opacity-70">
              <path d="M10 2v20M4 16l6 8 6-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        )}
      </>
    ))
  }
</div>
