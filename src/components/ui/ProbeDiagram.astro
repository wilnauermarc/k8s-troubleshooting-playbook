---
/** Readiness vs Liveness vs Startup — visual comparison. */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 760 360"
  class:list={['mx-auto h-auto w-full max-w-5xl', className]}
  role="img"
  aria-label="Probe comparison: readiness, liveness, startup"
>
  <!-- Readiness -->
  <rect x="20" y="36" width="220" height="280" rx="18" fill="#0d1526" stroke="#2dd4bf" stroke-width="3" />
  <circle cx="48" cy="64" r="10" fill="#2dd4bf" fill-opacity="0.25" stroke="#2dd4bf" stroke-width="1.5" />
  <text x="48" y="68" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="11" font-weight="700">1</text>
  <text x="130" y="72" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="22" font-weight="700">
    Readiness
  </text>
  <text x="130" y="102" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="13" letter-spacing="0.1em">
    CAN TAKE TRAFFIC?
  </text>
  <circle cx="130" cy="165" r="36" fill="#2dd4bf" fill-opacity="0.15" stroke="#2dd4bf" stroke-width="2.5" />
  <text x="130" y="172" text-anchor="middle" fill="#2dd4bf" font-family="Sora, sans-serif" font-size="28" font-weight="700">→</text>
  <text x="130" y="230" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    Remove from
  </text>
  <text x="130" y="254" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    Service path
  </text>
  <text x="130" y="286" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="14">
    Not Ready in slices
  </text>

  <!-- Liveness -->
  <rect x="270" y="36" width="220" height="280" rx="18" fill="#0d1526" stroke="#fb7185" stroke-width="3" />
  <circle cx="298" cy="64" r="10" fill="#fb7185" fill-opacity="0.25" stroke="#fb7185" stroke-width="1.5" />
  <text x="298" y="68" text-anchor="middle" fill="#fb7185" font-family="Sora, sans-serif" font-size="11" font-weight="700">2</text>
  <text x="380" y="72" text-anchor="middle" fill="#fb7185" font-family="Sora, sans-serif" font-size="22" font-weight="700">
    Liveness
  </text>
  <text x="380" y="102" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="13" letter-spacing="0.1em">
    PROCESS WEDGED?
  </text>
  <circle cx="380" cy="165" r="36" fill="#fb7185" fill-opacity="0.15" stroke="#fb7185" stroke-width="2.5" />
  <text x="380" y="172" text-anchor="middle" fill="#fb7185" font-family="Sora, sans-serif" font-size="28" font-weight="700">↻</text>
  <text x="380" y="230" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    Kill &amp; restart
  </text>
  <text x="380" y="254" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    container
  </text>
  <text x="380" y="286" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="14">
    CrashLoop risk
  </text>

  <!-- Startup -->
  <rect x="520" y="36" width="220" height="280" rx="18" fill="#0d1526" stroke="#fbbf24" stroke-width="3" />
  <circle cx="548" cy="64" r="10" fill="#fbbf24" fill-opacity="0.25" stroke="#fbbf24" stroke-width="1.5" />
  <text x="548" y="68" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="11" font-weight="700">3</text>
  <text x="630" y="72" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="22" font-weight="700">
    Startup
  </text>
  <text x="630" y="102" text-anchor="middle" fill="#8b9bb8" font-family="Sora, sans-serif" font-size="13" letter-spacing="0.1em">
    STILL BOOTING?
  </text>
  <circle cx="630" cy="165" r="36" fill="#fbbf24" fill-opacity="0.15" stroke="#fbbf24" stroke-width="2.5" />
  <text x="630" y="172" text-anchor="middle" fill="#fbbf24" font-family="Sora, sans-serif" font-size="26" font-weight="700">…</text>
  <text x="630" y="230" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    Blocks other
  </text>
  <text x="630" y="254" text-anchor="middle" fill="#e8eef9" font-family="Source Sans 3, sans-serif" font-size="16">
    probes until OK
  </text>
  <text x="630" y="286" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="14">
    Slow JVM / ML apps
  </text>

  <text x="380" y="345" text-anchor="middle" fill="#8b9bb8" font-family="Source Sans 3, sans-serif" font-size="14">
    Never swap jobs: readiness drains traffic · liveness restarts
  </text>
</svg>
