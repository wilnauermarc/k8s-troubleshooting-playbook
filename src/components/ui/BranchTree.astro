---
/**
 * Branching decision tree laid out as CSS grid — large text, clear Yes/No paths.
 */
interface Branch {
  question: string;
  yes: string;
  no: string;
  yesHint?: string;
  noHint?: string;
}

interface Props {
  title: string;
  branches: Branch[];
  class?: string;
}

const { title, branches, class: className = '' } = Astro.props;
---

<div class:list={['w-full space-y-6', className]}>
  <div class="flow-node flow-node-start mx-auto max-w-xl">{title}</div>

  {
    branches.map((b) => (
      <div class="grid items-stretch gap-3 md:grid-cols-[1fr_auto_1fr]">
        <div class="flow-node flow-node-ok order-2 md:order-1">
          <span class="mb-1 block text-xs font-semibold uppercase tracking-wider text-deck-cyan">Yes →</span>
          {b.yes}
          {b.yesHint && <div class="mt-1 font-sans text-sm font-normal text-deck-muted">{b.yesHint}</div>}
        </div>

        <div class="flow-node flow-node-decision order-1 md:order-2 md:self-center">
          {b.question}
        </div>

        <div class="flow-node flow-node-bad order-3">
          <span class="mb-1 block text-xs font-semibold uppercase tracking-wider text-deck-rose">No →</span>
          {b.no}
          {b.noHint && <div class="mt-1 font-sans text-sm font-normal text-deck-muted">{b.noHint}</div>}
        </div>
      </div>
    ))
  }
</div>
