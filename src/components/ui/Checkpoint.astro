---
interface Props {
  prompt: string;
  answer: string;
  hint?: string;
  class?: string;
}

const { prompt, answer, hint, class: className = '' } = Astro.props;
---

<div class:list={['rounded-2xl border-2 border-deck-amber/40 bg-deck-amber/5 p-6 md:p-8', className]}>
  <div class="mb-2 font-display text-xs font-semibold uppercase tracking-[0.16em] text-deck-amber">
    Checkpoint
  </div>
  <p class="font-display text-xl font-semibold text-deck-text md:text-2xl">{prompt}</p>
  {hint && <p class="mt-3 text-base text-deck-muted">{hint}</p>}
  <details class="mt-5 rounded-xl border border-deck-border bg-deck-panel/80 p-4">
    <summary class="cursor-pointer font-display text-sm font-semibold text-deck-cyan">Reveal answer</summary>
    <p class="mt-3 text-lg leading-relaxed text-deck-text/90">{answer}</p>
  </details>
</div>
